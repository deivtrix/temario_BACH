# GitIgnore para el repositorio temario_BACH

# Archivos de sistema y temporales
.DS_Store
Thumbs.db
*.log
*.tmp

# Archivos de cache de Python / entornos
__pycache__/
*.pyc

# Permitir subir configuracion de Obsidian para mantener notas y enlaces sincronizados
!.obsidian/

# Archivos pesados que no se deben subir
*.zip
*.rar
*.7z
